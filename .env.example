# Copy to `.env` for local development.

# Base URL of your Home Assistant instance (only needed during local dev — in
# production the dashboard is served by HA and uses window.location.origin).
VITE_HA_URL=http://homeassistant.local:8123

# Optional: a long-lived access token to skip the HA login screen during dev.
# Create one under HA → Profile → Security → Long-lived access tokens.
# Leave blank to use hakit's normal login flow.
# VITE_HA_TOKEN=
